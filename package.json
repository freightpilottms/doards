{
  "name": "rentpilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "supabase:prepare": "node deployment/prepare-supabase.mjs",
    "supabase:import": "node --env-file=.env.supabase server/migrate-supabase.mjs",
    "dev:supabase": "node --env-file=.env.supabase server/dev.mjs",
    "dev:stackblitz": "node deployment/release-template/deployment/dev.mjs",
    "release:supabase": "node deployment/create-supabase-release.mjs",
    "test:cloud": "npm run build && node tests/cloud-e2e.mjs",
    "test:layout": "npm run build && node tests/layout.mjs",
    "dev": "node server/dev.mjs",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:browser": "npm run build && node tests/e2e.mjs",
    "test:portals": "npm run build && node tests/portals.mjs",
    "test:client-demo": "npm run build && node tests/client-demo.mjs",
    "test:intelligence": "npm run build && node tests/intelligence.mjs",
    "format": "prettier --write src server",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.64.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3"
  }
}
