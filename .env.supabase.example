# Server-only. Copy to .env.supabase locally; never upload that file to GitHub.
# Supabase > Connect > Transaction pooler > URI.
# Replace the password placeholder (URL-encode reserved characters in the password).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Used only by the migration command to create/reset the selected administrator.
DOARDS_ADMIN_EMAIL=admin@example.com
DOARDS_ADMIN_PASSWORD=

# Optional: real passwords for fictional presentation accounts during demo provisioning.
# At least 16 characters. Never use the administrator's password here.
DOARDS_DEMO_PASSWORD=

# Server/Vercel settings. Generate a long random value for the scheduled-job endpoint.
CRON_SECRET=
DOARDS_SECURE_COOKIE=1
# Only enable on a database provisioned with the --demo command (fictional data).
DOARDS_PRESENTATION=0

# If your Supabase certificate chain requires the dashboard CA, supply its PEM here.
# TLS certificate validation remains enabled.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
