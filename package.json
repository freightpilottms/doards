{
  "name": "doards-release",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node deployment/dev.mjs",
    "start": "node --env-file-if-exists=.env.backend server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:browser": "npm run build && node tests/e2e.mjs",
    "test:portals": "npm run build && node tests/portals.mjs",
    "test:client-demo": "npm run build && node tests/client-demo.mjs",
    "test:intelligence": "npm run build && node tests/intelligence.mjs",
    "format": "prettier --write src server",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:full": "node server/dev.mjs",
    "test:deployment": "node --test deployment/*.test.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.64.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3"
  }
}
